# =============================================
# SPRING
# =============================================
SPRING_PROFILES_ACTIVE=dev
JAVA_TOOL_OPTIONS=

# =============================================
# POSTGRESQL
# =============================================
DB_URL=jdbc:postgresql://localhost:5432/gestion_citas
DB_USERNAME=postgres
DB_PASSWORD=postgres

# =============================================
# MONGODB
# =============================================
MONGO_URI=mongodb://localhost:27017/gestion_citas

# =============================================
# REDIS
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# =============================================
# KAFKA (solo perfil dev)
# =============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# =============================================
# JWT
# =============================================
JWT_SECRET=cambia-esto-por-una-clave-de-minimo-64-caracteres-en-produccion-xxx
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_MS=604800000

# =============================================
# MAIL
# =============================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# =============================================
# CORS Y FRONTEND
# =============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# =============================================
# CI/CD (GitHub Secret, no versionar)
# =============================================
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/...