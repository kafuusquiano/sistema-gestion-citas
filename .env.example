# Plantilla de variables de entorno. Copiar a .env y rellenar.
# .env esta en .gitignore y nunca se versiona (instruccion G5).

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=dev
# Solo en Render, para no pasar los 512 MB del plan gratuito
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# ---------- PostgreSQL ----------
# Local: PostgreSQL 18 instalado en Windows
DB_URL=jdbc:postgresql://localhost:5432/gestion_citas
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Produccion (Neon): jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require

# ---------- Redis ----------
# En dev no se usa: el perfil dev cachea con Caffeine en memoria.
# Produccion (Upstash):
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true

# ---------- JWT ----------
# En produccion generar con: openssl rand -base64 64
JWT_SECRET=clave-de-desarrollo-no-usar-en-produccion-minimo-64-caracteres-aqui
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_MS=604800000

# ---------- Correo ----------
# Local: Mailtrap sandbox, captura los correos sin enviarlos a nadie
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- CORS y frontend ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# ---------- CI/CD ----------
# No va en .env: se guarda como GitHub Secret del repositorio.
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/...
